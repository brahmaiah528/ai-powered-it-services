# Application Settings
PROJECT_NAME="AI-Powered IT Service Management & Incident Resolution Platform"
API_V1_STR="/api"
SECRET_KEY="enterprise-itsm-super-secret-jwt-key-production-ready"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEMO_MODE=true

# Database (PostgreSQL / SQLite fallback if postgres is offline)
DATABASE_URL="sqlite:///./itsm.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/itsm_db"

# Jira Cloud Integration (Leave mock/demo if not configured)
JIRA_URL="https://company-itsm.atlassian.net"
JIRA_EMAIL="devops-lead@enterprise.org"
JIRA_API_TOKEN="your_jira_api_token_here"
JIRA_PROJECT_KEY="ITSM"

# GitHub Integration
GITHUB_TOKEN="ghp_sample_enterprise_token"
GITHUB_REPOSITORY="enterprise-org/it-service-management"

# Jenkins Integration
JENKINS_URL="http://jenkins.internal.company.com:8080"
JENKINS_USERNAME="jenkins-admin"
JENKINS_TOKEN="jenkins_api_token"

# AI Engine
AI_API_KEY="sk-enterprise-ai-diagnostic-key"
OPENAI_MODEL="gpt-4o"
